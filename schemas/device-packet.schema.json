{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ULIANA Experimental Sensor Packet",
  "description": "Raw experimental sensor signal from a paired ESP32-style device. Until calibration and validation are complete, these values are not pressure, force, weight distribution, hand-load symmetry, or contact position.",
  "type": "object",
  "required": ["schema_version", "device_id", "sequence", "device_time_ms", "channels"],
  "properties": {
    "schema_version": { "const": 1 },
    "device_id": { "type": "string", "minLength": 3, "maxLength": 64 },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "device_time_ms": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "channels": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["channel_id", "raw_value"],
        "properties": {
          "channel_id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,32}$" },
          "raw_value": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 }
        },
        "additionalProperties": false
      }
    },
    "workout_session_id": { "type": ["string", "null"], "minLength": 1, "maxLength": 64 }
  },
  "additionalProperties": false
}
